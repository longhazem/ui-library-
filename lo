    nameLbl.Size = UDim2.new(1, -8, 0, 28)
    nameLbl.Position = UDim2.new(0, 4, 0.60, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text = data.name
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextSize = 15
    nameLbl.TextColor3 = Color3.fromRGB(60, 30, 80)
    nameLbl.ZIndex = 4
    nameLbl.Parent = card

    -- Lời thoại nhỏ
    local speechLbl = Instance.new("TextLabel")
    speechLbl.Size = UDim2.new(1, -6, 0, 22)
    speechLbl.Position = UDim2.new(0, 3, 0.80, 0)
    speechLbl.BackgroundTransparency = 1
    speechLbl.Text = data.desc
    speechLbl.Font = Enum.Font.Gotham
    speechLbl.TextSize = 13
    speechLbl.TextColor3 = Color3.fromRGB(100, 60, 120)
    speechLbl.ZIndex = 4
    speechLbl.Parent = card

    -- Nút nhấn vô hình phủ toàn card
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromScale(1, 1)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.ZIndex = 10
    btn.Parent = card

    -- Idle float animation
    local baseY = card.Position.Y.Scale
    task.spawn(function()
        local t = (idx - 1) * 0.38
        while card and card.Parent do
            t = t + task.wait(0.03)
            local offset = math.sin(t * 1.6) * 0.014
            card.Position = UDim2.new(xPos, 0, baseY + offset, 0)
        end
    end)

    -- Click handler
    btn.MouseButton1Click:Connect(function()
        -- Squish bounce
        doBounce(card)

        -- Ripple
        spawnRipple(card, data.fxCol)

        -- Particle FX
        task.spawn(function()
            spawnFX(BG, xPos + CARD_W / 2, 0.70, data.fx, data.fxCol)
        end)

        -- Emoji nảy lên rồi biến
        local popLbl = Instance.new("TextLabel")
