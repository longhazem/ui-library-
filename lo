-- ── Tạo thẻ con vật ───────────────────────────────────────
local CARD_W = 0.16
local GAP    = (1 - CARD_W * #ANIMALS) / (#ANIMALS + 1)

-- Hàm tạo hiệu ứng particle chữ/emoji bay ra
local function spawnFX(parent, ox, oy, symbols, col)
    for i = 1, 10 do
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0, 36, 0, 36)
        lbl.AnchorPoint = Vector2.new(0.5, 0.5)
        lbl.Position = UDim2.new(ox, 0, oy, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = symbols[math.random(#symbols)]
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = math.random(16, 26)
        lbl.TextColor3 = col
        lbl.ZIndex = 20
        lbl.Parent = parent

        local rx = (math.random() - 0.5) * 0.28
        local ry = -(math.random() * 0.25 + 0.08)

        local tween = TweenService:Create(lbl, TweenInfo.new(
            0.85 + math.random() * 0.4,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ), {
            Position = UDim2.new(ox + rx, 0, oy + ry, 0),
            TextTransparency = 1,
            TextStrokeTransparency = 1,
        })
        tween:Play()
        tween.Completed:Connect(function() lbl:Destroy() end)

        task.wait(0.04)
    end
end

-- Hàm squish + bounce tween
local function doBounce(card)
    local tweenIn = TweenService:Create(card, TweenInfo.new(
        0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out
    ), { Size = UDim2.new(card.Size.X.Scale * 0.88, 0, card.Size.Y.Scale * 1.18, 0) })

    local tweenOut = TweenService:Create(card, TweenInfo.new(
        0.28, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out
    ), { Size = UDim2.new(card.Size.X.Scale / 0.88 * 1.0, 0, card.Size.Y.Scale / 1.18 * 1.0, 0) })

    tweenIn:Play()
    tweenIn.Completed:Connect(function() tweenOut:Play() end)
end

-- Hàm tạo ripple (vòng tròn lan ra)
local function spawnRipple(parent, col)
    local ripple = Instance.new("Frame")
    ripple.AnchorPoint = Vector2.new(0.5, 0.5)
    ripple.Position = UDim2.fromScale(0.5, 0.5)
    ripple.Size = UDim2.new(0, 10, 0, 10)
    ripple.BackgroundColor3 = col
    ripple.BackgroundTransparency = 0.3
    ripple.BorderSizePixel = 0
    ripple.ZIndex = 5
    ripple.Parent = parent
    Instance.new("UICorner", ripple).CornerRadius = UDim.new(1, 0)

    local tween = TweenService:Create(ripple, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 220, 0, 220),
        BackgroundTransparency = 1,
    })
    tween:Play()
    tween.Completed:Connect(function() ripple:Destroy() end)
end

-- Tạo từng card
for idx, data in ipairs(ANIMALS) do
    local xPos = GAP * idx + CARD_W * (idx - 1)

    -- Card frame
    local card = Instance.new("Frame")
    card.Name = data.name
    card.AnchorPoint = Vector2.new(0, 1)
    card.Size = UDim2.new(CARD_W, 0, 0.52, 0)
    card.Position = UDim2.new(xPos, 0, 0.80, 0)
    card.BackgroundColor3 = data.color
    card.BorderSizePixel = 0
    card.ClipsDescendants = false
    card.Parent = BG

    local corner = Instance.new("UICorner", card)
    corner.CornerRadius = UDim.new(0, 22)

    -- Bóng đổ giả
    local shadow = Instance.new("Frame")
    shadow.Size = UDim2.new(1, 6, 1, 6)
    shadow.Position = UDim2.new(0, -3, 0, 5)
    shadow.BackgroundColor3 = Color3.fromRGB(80, 60, 100)
    shadow.BackgroundTransparency = 0.78
    shadow.BorderSizePixel = 0
    shadow.ZIndex = card.ZIndex - 1
    shadow.Parent = card
    Instance.new("UICorner", shadow).CornerRadius = UDim.new(0, 22)

    -- Stripe trang trí trên cùng
    local stripe = Instance.new("Frame")
    stripe.Size = UDim2.new(1, 0, 0, 8)
    stripe.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    stripe.BackgroundTransparency = 0.65
