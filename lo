        popLbl.AnchorPoint = Vector2.new(0.5, 1)
        popLbl.Position = UDim2.new(xPos + CARD_W / 2, 0, 0.68, 0)
        popLbl.BackgroundTransparency = 1
        popLbl.Text = data.emoji
        popLbl.TextSize = 48
        popLbl.Font = Enum.Font.GothamBold
        popLbl.ZIndex = 15
        popLbl.Parent = BG

        local popTween = TweenService:Create(popLbl, TweenInfo.new(
            0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out
        ), {
            Position = UDim2.new(xPos + CARD_W / 2, 0, 0.42, 0),
            TextTransparency = 1,
        })
        popTween:Play()
        popTween.Completed:Connect(function() popLbl:Destroy() end)

        -- Lời thoại nổi lên
        local talk = Instance.new("TextLabel")
        talk.Size = UDim2.new(0, 120, 0, 36)
        talk.AnchorPoint = Vector2.new(0.5, 1)
        talk.Position = UDim2.new(xPos + CARD_W / 2, 0, 0.64, 0)
        talk.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        talk.BackgroundTransparency = 0.05
        talk.Text = data.desc
        talk.Font = Enum.Font.GothamBold
        talk.TextSize = 17
        talk.TextColor3 = Color3.fromRGB(100, 50, 130)
        talk.BorderSizePixel = 0
        talk.ZIndex = 16
        talk.Parent = BG
        Instance.new("UICorner", talk).CornerRadius = UDim.new(0, 10)

        local talkTween = TweenService:Create(talk, TweenInfo.new(
            1.0, Enum.EasingStyle.Quad, Enum.EasingDirection.Out
        ), {
            Position = UDim2.new(xPos + CARD_W / 2, 0, 0.50, 0),
            TextTransparency = 1,
            BackgroundTransparency = 1,
        })
        task.wait(0.3)
        talkTween:Play()
        talkTween.Completed:Connect(function() talk:Destroy() end)
    end)

    -- Hover glow
    btn.MouseEnter:Connect(function()
        TweenService:Create(card, TweenInfo.new(0.15), {
            BackgroundColor3 = data.color:Lerp(Color3.fromRGB(255, 255, 255), 0.18)
        }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(card, TweenInfo.new(0.15), {
            BackgroundColor3 = data.color
        }):Play()
    end)
end

